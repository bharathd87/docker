FROM alpine/git as build
WORKDIR /src
RUN git clone https://github.com/Siddeshg672/hello_world_public_war.git

FROM maven:3.8.6-openjdk-8 as test
WORKDIR /build
COPY --from=build /src/ ./
WORKDIR hello_world_public_war
RUN mvn clean install

FROM tomcat:alpine
WORKDIR /usr/local/tomcat
COPY --from=test /build/hello_world_public_war/webapp/target/webapp.war ./webapps
